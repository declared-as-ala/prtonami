# ============================================================
#   PRENOTAMI SMART BOT — Environment Configuration
# ============================================================

# --- TARGET ---
PRENOTAMI_BASE_URL=https://prenotami.esteri.it
LOGIN_URL=https://prenotami.esteri.it/UserArea
SERVICE_ID=                        # The service/appointment type ID

# --- BOOKING DATE FILTER (optional) ---
APPOINTMENT_DATE_FROM=             # YYYY-MM-DD  (leave blank = any date)
APPOINTMENT_DATE_TO=               # YYYY-MM-DD  (leave blank = any date)

# --- BROWSER ---
HEADLESS=true                      # true = invisible | false = watch it run
SLOW_MO=0                          # ms delay between actions (debug only)

# --- ANTI-DETECTION ---
RANDOM_DELAY_MIN=800
RANDOM_DELAY_MAX=2500
ROTATE_USER_AGENT=true
USE_STEALTH_PLUGIN=true

# --- PROXY (optional) ---
USE_PROXY=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- TELEGRAM NOTIFICATIONS ---
NOTIFY_TELEGRAM=true
TELEGRAM_BOT_TOKEN=                # From @BotFather
TELEGRAM_CHAT_ID=                  # From @userinfobot

# --- CONCURRENCY ---
MAX_CONCURRENT_ACCOUNTS=5

# --- SESSIONS ---
SESSION_DIR=./sessions
REUSE_SESSIONS=true

# --- LOGGING ---
LOG_LEVEL=info                     # error | warn | info | debug
LOG_TO_FILE=true
LOG_DIR=./logs
